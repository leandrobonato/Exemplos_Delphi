*.local
*.identcache
*.projdata
*.tvsconfig
*.dsk

#
# Node.js (backends / web em alguns exemplos)
#
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env
.env.local

